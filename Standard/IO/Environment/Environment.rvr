module IO/Environment

import IO/Errors
import IO/File

# What the operating system gives the program when it starts and keeps for it: the arguments it was started with,
# the environment variables, and the working, home and temporary directories. All of it is read here, nothing is
# changed: a different working directory or environment goes to a child process through
# a child process. On a target without an operating system there are no
# arguments and no variables.

### The operating system's environment of this program: its arguments, its environment variables, and its working,
### home and temporary directories. Its routines are called on the type (`Environment.arguments()`), and they only
### read.
record Environment
    nothing

### Word `index` of a runtime block: the runtime hands back bytes as six U64 words (why it failed, the byte count, four
### more) and then the bytes, so what a call returns travels with it.
### :param block: The block.
### :param index: The word, 0 to 5.
### :returns: The word.
secret routine block_word(block: Hijacked[Byte], index: S64) -> U64
    danger
        return Hijacked[U64](block.stride(count: index * 8).address()).peek()

### Whether the call that made the block failed (a variable that isn't set, a directory that can't be told). A block
### that isn't there counts as failed.
### :param block: The block.
### :returns: True when it failed.
secret routine block_failed(block: Hijacked[Byte]) -> Bool
    if block.is_hollow()
        return true
    return block_word(block: block, index: 0) != 0

### The bytes of a runtime block, copied once. The block is given back.
### :param block: The block, or a hollow pointer.
### :returns: The bytes, empty for a failed block.
secret routine block_bytes(block: Hijacked[Byte]) -> Bytes
    if block.is_hollow()
        return Bytes(ptr: block, count: 0)
    var count = block_word(block: block, index: 1)
    danger
        var bytes = Bytes(ptr: block.stride(count: 48), count: count)
        C::rf_invalidate(ptr: block.address())
        return bytes

### Gives the runtime's block back.
### :param block: The block, or a hollow pointer.
secret routine block_free(block: Hijacked[Byte])
    if not block.is_hollow()
        danger
            C::rf_invalidate(ptr: block.address())
    return

### The runtime block's bytes as text. The block is given back.
### :param block: The block.
### :returns: The text.
### :throws: {MalformedUtf8Error} if the bytes are not well-formed UTF-8.
secret routine environment_text(block: Hijacked[Byte]) -> Text
    return block_bytes(block: block).decode_as_utf8()

### The runtime block's bytes as text, with U+FFFD in place of each malformed sequence. The block is given back.
### :param block: The block.
### :returns: The text.
secret routine environment_text_lossy(block: Hijacked[Byte]) -> Text
    return block_bytes(block: block).decode_as_utf8_lossy()

### The arguments the program was started with, its own name left out.
### :returns: The arguments, in order.
### :throws: {MalformedUtf8Error} when an argument is not UTF-8.
common routine Environment.arguments() -> List[Text]
    var result = List[Text]()
    for i in 0 til C::rf_env_argument_count()
        result.add_last(value: environment_text(block: C::rf_env_argument(index: i)))
    return result

### The arguments the program was started with, its own name left out, with U+FFFD in place of each malformed UTF-8
### sequence.
### :returns: The arguments, in order.
common routine Environment.arguments_lossy() -> List[Text]
    var result = List[Text]()
    for i in 0 til C::rf_env_argument_count()
        result.add_last(value: environment_text_lossy(block: C::rf_env_argument(index: i)))
    return result

### The value of the environment variable `name`, asked of the operating system now (on Windows the name's case
### doesn't matter).
### :param name: The variable's name.
### :returns: Its value, or `none` when it isn't set.
### :throws: {MalformedUtf8Error} when the value is not UTF-8.
common routine Environment.variable(name: Text) -> Text?
    var cstr = name.to[CStr]()
    var block = C::rf_env_variable(name: cstr, len: cstr.count().to[S32]())
    if block_failed(block: block)
        block_free(block: block)
        return none
    return environment_text(block: block)

### The value of the environment variable `name`, with U+FFFD in place of each malformed UTF-8 sequence.
### :param name: The variable's name.
### :returns: Its value, or `none` when it isn't set.
common routine Environment.variable_lossy(name: Text) -> Text?
    var cstr = name.to[CStr]()
    var block = C::rf_env_variable(name: cstr, len: cstr.count().to[S32]())
    if block_failed(block: block)
        block_free(block: block)
        return none
    return environment_text_lossy(block: block)

### Every environment variable as the operating system has them now, as one text: each name and value ends with a
### NUL.
### :param lossy: Whether a malformed UTF-8 sequence becomes U+FFFD instead of failing.
### :returns: The text.
### :throws: {MalformedUtf8Error} when a name or value is not UTF-8 and `lossy` is false.
secret routine environment_snapshot(lossy: Bool) -> Text
    var block = C::rf_env_snapshot()
    if lossy
        return environment_text_lossy(block: block)
    return environment_text(block: block)

### Every environment variable as the operating system has them now: each name followed by its value.
### :param lossy: Whether a malformed UTF-8 sequence becomes U+FFFD instead of failing.
### :returns: The names and values, in pairs.
### :throws: {MalformedUtf8Error} when a name or value is not UTF-8 and `lossy` is false.
secret routine environment_parts(lossy: Bool) -> List[Text]
    var parts = environment_snapshot(lossy: lossy).split(separator: '\0')
    # The last variable's value ends with a NUL too, which leaves one empty part after it.
    if parts.count() % 2 == 1
        drop parts.remove_last()
    return parts

### The names and values in pairs as a dictionary.
### :param parts: Each name followed by its value.
### :returns: The variables by name.
secret routine environment_dict(parts: List[Text]) -> Dict[Text, Text]
    var result = Dict[Text, Text]()
    var i: U64 = 0
    until i + 1 >= parts.count()
        result[parts[i]] = parts[i + 1]
        i += 2
    return result

### Every environment variable with its value, as the operating system has them now: a copy, which changes nothing
### when it changes.
### :returns: The variables by name.
### :throws: {MalformedUtf8Error} when a name or value is not UTF-8.
common routine Environment.to[Dict[Text, Text]]() -> Dict[Text, Text]
    return environment_dict(parts: environment_parts(lossy: false))

### Every environment variable with its value, with U+FFFD in place of each malformed UTF-8 sequence.
### :returns: The variables by name.
common routine Environment.variables_lossy() -> Dict[Text, Text]
    return environment_dict(parts: environment_parts(lossy: true))

### The program's working directory, which relative paths start from.
### :returns: The resulting `Directory`.
### :throws: {IOError} when the working directory cannot be read.
common routine Environment.working_directory() -> Directory
    var block = C::rf_fs_current_dir()
    if block_failed(block: block)
        block_free(block: block)
        throw IOError(description: "Cannot read the working directory")
    return Directory(at: environment_text(block: block))

### The current user's home directory.
### :returns: The resulting `Directory`.
### :throws: {NotFoundError} when the home directory cannot be told.
common routine Environment.home_directory() -> Directory
    var block = C::rf_fs_home_dir()
    if block_failed(block: block)
        block_free(block: block)
        throw NotFoundError(description: "Cannot tell the home directory")
    return Directory(at: environment_text(block: block))

### The platform's temporary directory. Honors the usual environment variables, never fails.
### :returns: The resulting `Directory`.
common routine Environment.temp_directory() -> Directory
    return Directory(at: environment_text(block: C::rf_fs_temp_dir()))
