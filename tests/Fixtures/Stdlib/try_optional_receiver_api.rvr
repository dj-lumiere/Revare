module Tests/Stdlib/TryOptionalReceiverApi

import IO/Console
# try and check reach through a T? receiver: a none receiver is an AbsentValueError the same keyword receives,
# otherwise the call runs on the value. Nothing changes without the keyword. A link (`Modifying[E]?` kept in a member
# variable) used without `when` takes its token first, and check tells a missing link (AbsentValueError) from an ended
# entity (StaleLinkError).

record Pt
    x: S64

routine Pt.twice(k: S64) -> S64
    return me.x * k

routine Pt.boom() -> S64
    throw DivisionByZeroError()

routine Pt.deep(k: S64) -> S64
    return me.twice(k: k) + me.boom()

entity Node
    value: S64
    parent: Modifying[Node]?

@readonly
routine Node.get() -> S64
    return me.value

entity Counter
    n: S64

routine Counter.bump() -> S64
    me.n += 1
    return me.n

variant Shape
    S64
    Text

routine Shape.size() -> S64
    when me
        is S64 as n => return n
        is Text as t => return 7

routine value_of(node: Viewing[Node]) -> S64
    when try node.parent.value
        is None => return -1
        else as v => return v

routine what_happened(node: Viewing[Node]) -> Text
    when check node.parent.get()
        is S64 as v => return f"node {v}"
        is AbsentValueError => return "no link"
        is StaleLinkError => return "ended"
        else => return "other"

routine start()
    var some: Pt? = Pt(x: 21)
    var none_pt: Pt? = none
    show(f"try on a value: {try some.twice(k: 2)}")
    show(f"try on none: {try none_pt.twice(k: 2)}")
    show(f"try below the receiver: {try some.deep(k: 2)}")
    when check none_pt.twice(k: 3)
        is S64 as v => show(f"check on none gave {v}")
        else as e => show(f"check on none: {e.crash_message()}")
    when check some.twice(k: 3)
        is S64 as v => show(f"check on a value: {v}")
        else as e => show(f"check on a value failed: {e.crash_message()}")

    var nodes = List[Node]()
    nodes.add_last(value: Node(value: 7, parent: none))
    nodes.add_last(value: Node(value: 8, parent: none))
    nodes[1].parent = nodes[0]
    show(f"parent of b: {value_of(node: nodes[1])}, of a: {value_of(node: nodes[0])}")
    show(f"split: {what_happened(node: nodes[1])}, {what_happened(node: nodes[0])}")
    drop nodes.remove_first()
    show(f"after a ended: {value_of(node: nodes[0])}, {what_happened(node: nodes[0])}")

    var xs: List[S64]? = [1, 2]
    drop try xs.add_last(value: 3)
    show(f"try changed the original list: {xs}")
    var counter: Counter? = Counter(n: 1)
    drop try counter.bump()
    show(f"try bumped the original: {try counter.bump()}")
    var no_counter: Counter? = none
    show(f"try on no entity: {try no_counter.bump()}")
    var shape: Shape? = Shape(5)
    show(f"try on a variant: {try shape.size()}")

    var optionals: List[S64?] = []
    optionals.add_last(value: 5)
    optionals.add_last(value: none)
    var ends_in_value: S64? = try optionals.first()
    var ends_in_none: S64? = try optionals.last()
    var past_the_end: S64? = try optionals.getitem(index: 9)
    show(f"a chain ending in a T? gives one T?: {ends_in_value}, {ends_in_none}, {past_the_end}")
    var walked = 0
    for element in optionals
        walked += 1
    show(f"a for over List[S64?] walks past a none element: {walked}")
    when check optionals.last()
        is S64 as v => show(f"check gave {v}")
        is AbsentValueError => show("check: a none end is an AbsentValueError")
        else as e => show(f"check failed: {e.crash_message()}")
    show("DONE")
    return
