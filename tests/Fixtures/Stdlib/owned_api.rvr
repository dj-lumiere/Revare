module Tests/Stdlib/OwnedApi

import BuilderQuery
import IO/Console
entity Counter
    value: S64

routine Counter.bump(amount: S64)
    me.value = me.value + amount
    return

routine start()
    var c = Counter(value: 10)
    show(f"c type: {c.type_name()}")
    show(f"c value: {c.value}")

    c.bump(amount: 5)
    show(f"after bump(5): {c.value}")

    # a read reference
    var v: %Counter = c
    show(f"view type: {v.type_name()}")
    show(f"view value: {v.value}")

    # a write reference
    var m = c
    m.bump(amount: 100)

    # represent / diagnose
    show(f"c represent: {c}")
    show(f"c diagnose: {c:?}")

    show("DONE")
    return
