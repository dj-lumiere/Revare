module Tests/Stdlib/ReceiverEndedByArgumentsApi

# A call's arguments run before the call. When an argument ends the entity a reference from a link reaches, and that
# reference is the call's receiver (`n.attach(world.remove(n))`) or reaches a member of it the call works on
# (`n.kids.add_last(...)`), the reference is checked again after the arguments: the call fails with the ended-entity
# failure, which `try` and `check` receive, and never reaches the entity that took the slot. A number read out of the
# entity before the argument runs is a copy, which stays good, with or without a `try` in front of the call. Each statement below is written without `try` in a
# routine of its own: its reference parameter comes from a link, so the builder cannot prove it alive.

import IO/Console

entity Node
    id: S64
    kids: List[S64]

dangerous routine Node.destruct()
    show(f"end {me.id} with {me.kids.count()} kids")
    return

entity World
    nodes: List[Node]

entity Watch
    target: @Node?

routine World.remove(node: @Node) -> S64
    var id = node.id
    drop me.nodes.remove_last()
    me.nodes.add_last(value: Node(id: 77, kids: []))
    return id

routine World.peek(node: @Node) -> S64
    return node.id

routine Node.attach(slot: S64) -> S64
    return me.id * 10 + slot

routine Node.attach_self(world: @World) -> S64
    return me.attach(slot: world.remove(node: me))

routine attach_removed(n: @Node, world: @World) -> S64
    return n.attach(slot: world.remove(node: n))

routine attach_peeked(n: @Node, world: @World) -> S64
    return n.attach(slot: world.peek(node: n))

routine add_kid_removed(n: @Node, world: @World)
    n.kids.add_last(value: world.remove(node: n))
    return

routine id_plus_removed(n: @Node, world: @World) -> S64
    return n.id.add(you: world.remove(node: n))

routine id_plus_removed_tried(n: @Node, world: @World) -> S64?
    return try n.id.add(you: world.remove(node: n))

routine fresh(world: @World, w: @Watch)
    drop world.nodes.remove_last()
    world.nodes.add_last(value: Node(id: 1, kids: []))
    w.target = world.nodes[0]
    return

routine start()
    var world = World(nodes: [])
    world.nodes.add_last(value: Node(id: 1, kids: []))
    var w = Watch(target: none)
    w.target = world.nodes[0]
    when w.target
        is None => show("none")
        else as n =>
            when try attach_peeked(n: n, world: world)
                is None => show("attach after peek: try none")
                else as v => show(f"attach after peek {v}")
            when try attach_removed(n: n, world: world)
                is None => show("attach after remove: try none")
                else as v => show(f"attach after remove {v}")
    fresh(world: world, w: w)
    when w.target
        is None => show("none")
        else as n =>
            when check add_kid_removed(n: n, world: world)
                is None => show("add_last after remove: check none")
                else => show("add_last after remove: check failed")
    fresh(world: world, w: w)
    when w.target
        is None => show("none")
        else as n =>
            when try id_plus_removed(n: n, world: world)
                is None => show("id read before remove: try none")
                else as v => show(f"id read before remove {v}")
    fresh(world: world, w: w)
    when w.target
        is None => show("none")
        else as n =>
            when id_plus_removed_tried(n: n, world: world)
                is None => show("id read before remove, in try: none")
                else as v => show(f"id read before remove, in try {v}")
    fresh(world: world, w: w)
    when w.target
        is None => show("none")
        else as n =>
            when try n.id.add(you: world.remove(node: n))
                is None => show("id read before remove, try here: none")
                else as v => show(f"id read before remove, try here {v}")
    fresh(world: world, w: w)
    when w.target
        is None => show("none")
        else as n =>
            when try n.attach_self(world: world)
                is None => show("attach_self: try none")
                else as v => show(f"attach_self {v}")
    show(f"slot holds {world.nodes[0].id} with {world.nodes[0].kids.count()} kids")
    return
