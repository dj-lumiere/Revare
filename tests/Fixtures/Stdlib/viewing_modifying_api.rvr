module Tests/Stdlib/ViewingModifyingApi

import BuilderQuery
import IO/Console
entity Box
    value: S64

routine Box.set(value: S64)
    me.value = value
    return

routine start()
    var b = Box(value: 7)

    # A read reference: a local typed `%Box` reads the entity.
    var v: %Box = b
    show(f"v type: {v.type_name()}")
    show(f"v.value via forward: {v.value}")

    # A write reference: a second name for an entity changes it.
    var m = b
    show(f"m type: {m.type_name()}")
    m.set(value: 42)
    show(f"after modify.set(42): {b.value}")

    # A read reference taken from a write one.
    var another = Box(value: 100)
    var w = another
    var v2: %Box = w
    show(f"v2 type: {v2.type_name()}")
    show(f"v2.value: {v2.value}")

    show("DONE")
    return
