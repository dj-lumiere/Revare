module Tests/Stdlib/FlagsMembershipApi

import IO/Console

# `has` asks for all of the members, `has_any` for at least one, `lacks` for none. The flags value with no member on is
# `empty`, also in a preset, a record preset, a parameter, a return, a `CellMarks?` place and a generic `T?` place.
# Elsewhere `empty` is a name like any other.

flags CellMarks
    MINE
    REVEALED
    FLAGGED

record Cell
    marks: CellMarks
    adjacent_mines: S64

preset EMPTY_MARKS: CellMarks = empty
preset BLANK: Cell = Cell(marks: empty, adjacent_mines: 0)
preset COMPUTED_BLANK: Cell = Cell(marks: empty, adjacent_mines: 1 + 1)
preset MINED: Cell = Cell(marks: CellMarks.MINE and CellMarks.FLAGGED, adjacent_mines: 2 * 3)

routine cleared() -> CellMarks
    return empty

routine is_blank(marks: CellMarks) -> Bool
    return marks == empty

routine or_else[T](x: T?, fallback: T) -> T
    if x is None
        return fallback
    return x

routine count_label(count: S64) -> Text
    var empty = count == 0
    if empty
        return "no items"
    return "some items"

routine start()
    var marks = CellMarks.MINE and CellMarks.FLAGGED
    show(f"has(MINE and FLAGGED): {marks.has(MINE and FLAGGED)}")
    show(f"has(MINE and REVEALED): {marks.has(MINE and REVEALED)}")
    show(f"has_any(MINE and REVEALED): {marks.has_any(MINE and REVEALED)}")
    show(f"has_any(REVEALED): {marks.has_any(REVEALED)}")
    show(f"lacks(REVEALED and FLAGGED): {marks.lacks(REVEALED and FLAGGED)}")
    show(f"lacks(REVEALED): {marks.lacks(REVEALED)}")
    show(f"lacks(MINE and FLAGGED): {marks.lacks(MINE and FLAGGED)}")

    var blank: CellMarks = empty
    show(f"blank: {blank}")
    show(f"blank == empty: {blank == empty}")
    show(f"empty != blank: {empty != blank}")
    show(f"blank.lacks(MINE and REVEALED and FLAGGED): {blank.lacks(MINE and REVEALED and FLAGGED)}")
    blank = REVEALED
    show(f"after REVEALED: {blank}, == empty: {blank == empty}")
    marks = empty
    show(f"marks cleared: {marks}")

    var absent: CellMarks? = none
    show(f"absent Optional is none: {absent is None}")

    var present: CellMarks? = empty
    show(f"present Optional: {present is None}, {present}, absent: {absent}")
    show(f"return: {cleared()}, parameter: {is_blank(marks: empty)}")
    show(f"generic: {or_else[CellMarks](x: empty, fallback: CellMarks.MINE)}, {or_else[CellMarks](x: none, fallback: CellMarks.MINE)}")
    show(f"a name elsewhere: {count_label(count: 0)}, {count_label(count: 2)}")

    show(f"EMPTY_MARKS: {EMPTY_MARKS}")
    show(f"BLANK.marks: {BLANK.marks}, lacks(MINE): {BLANK.marks.lacks(MINE)}")
    show(f"COMPUTED_BLANK: {COMPUTED_BLANK.marks}, {COMPUTED_BLANK.adjacent_mines}")
    show(f"MINED: {MINED.marks}, {MINED.adjacent_mines}")
    return
