module Tests/Stdlib/AccessArgumentApi

import IO/Console
# A Guarded is opened with a block, and the names the block gives are references: they go where a reference
# parameter is expected, and one block opens several Guardeds together.

routine argument_add(entries: @List[S64], value: S64)
    entries.add_last(value: value)
    return

routine argument_copy_over(into: @List[S64], from: %List[S64])
    for v in from
        into.add_last(value: v)
    return

routine argument_count_of(entries: %List[S64]) -> U64
    return entries.count()

routine start()
    var log = Guarded[List[S64], MultiRead](from: List[S64]())
    var other = Guarded[List[S64], Exclusive](from: [7, 8])
    modifying log as entries
        argument_add(entries: entries, value: 1)
        argument_add(entries: entries, value: 2)
    viewing log as entries
        var n = entries.count()
        show(n)
    modifying log as into, other as from
        argument_copy_over(into: into, from: from)
    viewing log as entries
        show(argument_count_of(entries: entries))
    viewing log as entries
        show(entries)
    show("DONE")
    return
