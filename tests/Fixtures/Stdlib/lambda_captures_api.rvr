module Tests/Stdlib/LambdaCapturesApi

import IO/Console
import EmitterTools
# Lambdas capture surrounding bindings — verifies the closure machinery used by
# EmitterTools `where`/`select`/etc. with non-trivial bodies.

routine make_adder(n: S64) -> Callable[(S64,), S64]
    return x given n => x + n

# A lambda passed to a Routine parameter takes its parameter types from it, also when another argument is a
# bare literal or the arguments are named out of order.
routine twice(f: Callable[(S64,), S64], x: S64) -> S64
    return f(f(x))

routine apply(x: S64, f: Callable[(S64,), S64]) -> S64
    return f(x)

# A capturing lambda kept in a list, a record and an entity, copied, replaced and returned: each copy holds what it
# captured, and the captured values are let go when the last copy goes.
record Ops
    apply: Callable[(S64,), Text]

entity Keeper
    f: Callable[(S64,), Text]

routine make_labeler(tag: Text) -> Callable[(S64,), Text]
    return x given tag => f"{tag}{x}"

routine keep_round(i: S64) -> Text
    var f = make_labeler(tag: f"k{i}-")
    var g = f
    var fs: List[Callable[(S64,), Text]] = [g, make_labeler(tag: "z")]
    var ops = Ops(apply: fs[0])
    var copied = ops
    var keeper = Keeper(f: copied.apply)
    keeper.f = make_labeler(tag: "w")
    var h: Callable[(S64,), Text] = x given f => f"{f(x)}!"
    g = h
    var second = fs[1]
    return f"{f(1)} {second(2)} {copied.apply(3)} {keeper.f(4)} {g(5)}"

routine start()
    # Simple capture
    var add5 = make_adder(n: 5)
    show(f"add5(10): {add5(10)}")
    show(f"add5(-3): {add5(-3)}")

    # Capture used in EmitterTools chain
    var threshold = 4
    var src: List[S64] = [1, 2, 3, 4, 5, 6, 7, 8]
    var above = src.where(predicate: x given threshold => x > threshold).to[List]()
    show(f"above {threshold}: {above}")

    # Mutating capture target (via `given` for explicit capture binding)
    var sum = 0
    for x in src
        sum = sum + x
    show(f"sum via for: {sum}")

    # Capture in select with arithmetic
    var scale = 3
    var scaled = src.select(transform: x given scale => x * scale).to[List]()
    show(f"scaled by {scale}: {scaled}")

    # Lambda parameters typed by the Routine parameter
    show(f"twice +1 from 2: {twice(f: y => y + 1, x: 2)}")
    show(f"apply *10 to 4: {apply(f: y => y * 10, x: 4)}")
    show(f"twice -1 from 5: {twice(x: 5, f: y => y - 1)}")

    for i in 0 til 3
        show(keep_round(i: i))

    show("DONE")
    return
