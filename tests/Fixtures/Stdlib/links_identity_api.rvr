module Tests/Stdlib/LinksIdentityApi

import IO/Console
# Two links compare with `===` / `!==`: the same entity and the same slot generation. A link has no `==`. A link to an
# entity that ended is not the same as a link to the next entity in its slot. A link is a `Set` element and a `Dict`
# key by that identity, which stays the same after its entity ends. What is read after the entity ended is kept in a
# member variable: a local that holds references lasts only as long as its entities.

entity Node
    id: S64

entity Kept
    a: @Node?
    c: @Node?
    seen: Set[@Node?]
    score: Dict[@Node?, S64]

routine start()
    var nodes = List[Node]()
    for i in 0 til 4
        nodes.add_last(value: Node(id: i))
    var a: @Node? = nodes[0]
    var b: @Node? = nodes[0]
    var c: @Node? = nodes[1]
    var empty: @Node? = none
    var other_empty: @Node? = none
    show(f"{a === b} {a === c} {a !== c} {a === empty} {empty === other_empty}")
    var k = Kept(a: a, c: c, seen: Set[@Node?](), score: Dict[@Node?, S64]())
    drop k.seen.add(a)
    drop k.seen.add(b)
    drop k.seen.add(c)
    show(f"set: {k.seen.count()}")
    k.score[a] = 10
    k.score[c] = 20
    drop nodes.remove_first()
    nodes.add_last(value: Node(id: 9))
    var d: @Node? = nodes[3]
    show(f"ended vs next in its slot: {k.a === d}")
    show(f"still keyed: {k.seen.has(k.a)} {k.seen.has(d)} {k.score[k.a]} {k.score.count()}")
    var links = List[@Node?]()
    links.add_last(value: k.c)
    links.add_last(value: d)
    var found: S64 = 0
    for link in links
        if link === d
            found += 1
    show(f"found in a list: {found}")
    return
