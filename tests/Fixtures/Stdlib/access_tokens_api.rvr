module Tests/Stdlib/AccessTokensApi

import IO/Console
# An element of a list a routine takes can be held while a list the routine made itself grows: the two are different
# lists. Two references a routine takes may be the same list, so holding an element of one while the other changes
# shape is a build error (RV-S640). A write reference goes where a read reference is expected.

record Point
    x: S64
    y: S64

routine tokens_grow_while_held(x: @List[Point]) -> List[Point]
    var y = List[Point]()
    var p = x.modify_at(index: 0)
    for i in 1 to 100
        y.add_last(value: Point(x: i, y: i))
    p.x = 999
    return y

routine tokens_merge(into: @List[S64], from: %List[S64])
    for v in from
        into.add_last(value: v)
    return

routine tokens_total(items: @List[S64]) -> S64
    var sum = 0
    for v in items
        sum += v
    return sum

routine start()
    var s = List[Point]()
    s.add_last(value: Point(x: 0, y: 0))
    var t = tokens_grow_while_held(x: s)
    show(f"held: {s[0].x}, grown: {t.count()}")
    var a = [1, 2]
    var b = [3, 4]
    tokens_merge(into: a, from: b)
    show(a)
    show(tokens_total(items: a))
    show("DONE")
    return
